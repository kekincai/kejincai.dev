---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { portfolioGroups } from '../../data/portfolio';
const groups = portfolioGroups.slice(1);
---

<BaseLayout
  title="Lab — KEJINCAI.DEV"
  description="一些有趣的实验和小工具：书签、设计模式、TaskPaper、文件查重、Racket、网速、笔记导出、贪吃蛇与播客自动化。"
>
  <div class="container page-content lab-ledger">
    <div class="page-heading">
      <p class="eyebrow yellow">SIDE PROJECTS / SMALL TOOLS</p>
      <h1>Experiments & tools.</h1>
      <p lang="zh-CN">一些好玩的尝试，和解决具体问题的小工具。</p>
    </div>
    {groups.map((group) => (
      <section class="side-group" aria-labelledby={`heading-${group.id}`}>
        <div class="side-group-heading">
          <h2 id={`heading-${group.id}`} lang="zh-CN">
            {group.label}
          </h2>
          <span class="micro">
            {String(group.projects.length).padStart(2, '0')} ENTRIES
          </span>
        </div>
        <ul class="side-list">
          {group.projects.map((project, index) => (
            <li>
              <a
                href={`https://github.com/kekincai/${project.repo}`}
                target="_blank"
                rel="noopener noreferrer"
                class="side-row"
              >
                <span class="side-index micro" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{project.name}</h3>
                  <p lang="zh-CN">{project.description}</p>
                </div>
                <span class="side-tags micro">
                  {project.tags.slice(0, 2).join(' / ')}
                </span>
                <Arrow diagonal />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <div class="cross-link">
      <span>Selected work.</span>
      <a class="text-link micro" href="/projects/">
        VIEW PROJECTS →
      </a>
    </div>
  </div>
</BaseLayout>
