---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import { portfolioGroups } from '../../data/portfolio';
const groups = portfolioGroups.slice(1);
---

<BaseLayout
  title="Lab — KEJINCAI.DEV"
  description="6 个有趣的实验与 3 个小工具：浏览器、MCP、Racket、Rust、Swift 与 R 的探索。"
>
  <div class="container page-content">
    <div class="page-heading">
      <p class="eyebrow yellow">LAB / 09 PROJECTS</p>
      <h1>Curiosity in code.</h1>
      <p lang="zh-CN">有趣的实验与小工具。每一个项目，都是另一种做法。</p>
    </div>
    <div
      class="lab-filters"
      role="group"
      aria-label="Filter projects by category"
      hidden
    >
      <button data-filter="all" aria-pressed="true">
        全部 9
      </button>
      {groups.map((group) => (
        <button data-filter={group.id} aria-pressed="false">
          {group.label} {group.projects.length}
        </button>
      ))}
    </div>
    <div class="work-grid">
      {groups.flatMap((group, groupIndex) =>
        group.projects.map((project, index) => (
          <div class="lab-project" data-category={group.id}>
            <PortfolioCard
              project={project}
              number={String((groupIndex === 0 ? 3 : 9) + index + 1).padStart(
                2,
                '0',
              )}
            />
          </div>
        )),
      )}
    </div>
    <p class="lab-count micro" aria-live="polite">
      9 PROJECTS / ALL
    </p>
    <div class="cross-link">
      <span>Explore the selected projects.</span>
      <a class="text-link micro" href="/projects/#selected">
        SELECTED WORK →
      </a>
    </div>
  </div>
</BaseLayout>
<script>
  const initialized = new WeakSet<Element>();
  function setupFilters() {
    const filters = document.querySelector<HTMLElement>('.lab-filters');
    if (!filters || initialized.has(filters)) return;
    initialized.add(filters);
    filters.hidden = false;
    const rows = Array.from(
      document.querySelectorAll<HTMLElement>('.lab-project'),
    );
    const buttons = Array.from(
      filters.querySelectorAll<HTMLButtonElement>('button'),
    );
    const count = document.querySelector<HTMLElement>('.lab-count');
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const category = button.dataset.filter;
        buttons.forEach((b) =>
          b.setAttribute('aria-pressed', String(b === button)),
        );
        rows.forEach(
          (row) =>
            (row.hidden =
              category !== 'all' && row.dataset.category !== category),
        );
        if (count)
          count.textContent = `${rows.filter((row) => !row.hidden).length} PROJECTS / ${category?.toUpperCase()}`;
      }),
    );
  }
  document.addEventListener('astro:page-load', setupFilters);
  setupFilters();
</script>
