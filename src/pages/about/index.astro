---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { site } from '../../data/site';
---

<BaseLayout
  title="About Node — KEJINCAI.DEV"
  description="Ke Jincai, a software engineer based in Tokyo. Interested in AI, software engineering, data, language and photography."
>
  <div class="container page-content about-page">
    <div class="page-heading">
      <p class="eyebrow yellow">ABOUT NODE</p>
      <h1>
        KE JINCAI<span class="name-dot">.</span>
      </h1>
      <p>SOFTWARE ENGINEER / TOKYO NODE.</p>
    </div>
    <div class="about-grid">
      <div class="about-story">
        <h2 lang="ja">構築。解析。記録。</h2>
        <div lang="ja">
          <p>TOKYO NODE / 個人開発の接続点。</p>
          <p>
            ソフトウェア、AI、データ。気になる信号を拾い、コードに変える。実装と実験の記録を、このノードに集める。
          </p>
          <p>BUILD. LEARN. LOG. 次のアイデアへ、回線は開いたまま。</p>
        </div>
        <a
          class="text-link micro"
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          OPEN SOURCE LINK <Arrow diagonal />
        </a>
        <p>
          <a class="text-link micro" href={`mailto:${site.email}`}>
            {site.email} <Arrow diagonal />
          </a>
        </p>
      </div>
      <div class="interests">
        <h2 class="micro">INTERESTED IN</h2>
        <ol>
          {[
            'AI',
            'Software Engineering',
            'Data',
            'Language',
            'Photography',
          ].map((interest, i) => (
            <li>
              <span class="micro">{String(i + 1).padStart(2, '0')}</span>
              {interest}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="about-end mono">
      <span>TOKYO / PERSONAL NODE</span>
      <span class="online">
        <i></i> KEEP BUILDING
      </span>
    </div>
  </div>
</BaseLayout>
