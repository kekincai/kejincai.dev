---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import NodeCard from '../../components/NodeCard.astro';
import { projects } from '../../data/site';
import SectionHeading from '../../components/SectionHeading.astro';
import { portfolioGroups } from '../../data/portfolio';
---

<BaseLayout
  title="Projects — KEJINCAI.DEV"
  description="精选作品：Infinity New Tab、Disk Ferry 与 Safe Clip。三个日常使用的软件项目，以及三个独立网站入口。"
>
  <div class="container page-content">
    <div class="page-heading">
      <p class="eyebrow yellow">SELECTED WORK / 03</p>
      <h1>Made to be used.</h1>
      <p lang="zh-CN">三个认真打磨、日常用得上的软件。</p>
    </div>
    <section class="portfolio-section" id="selected" aria-label="精选项目">
      <div class="work-grid work-grid-featured">
        {portfolioGroups[0].projects.map((project, index) => (
          <PortfolioCard
            project={project}
            number={String(index + 1).padStart(2, '0')}
            featured
          />
        ))}
      </div>
    </section>
    <section class="portfolio-section" id="connected">
      <SectionHeading
        label="CONNECTED NODES"
        title="Connected worlds."
        description="独立网站，持续记录。"
      />
      <div class="node-grid">
        {projects.map((project) => (
          <NodeCard project={project} />
        ))}
      </div>
    </section>
    <aside class="lab-invitation">
      <div>
        <p class="micro">SIDE PROJECTS / SMALL TOOLS</p>
        <p lang="zh-CN">一些好玩的小实验和实用脚本，收在 Lab 里。</p>
      </div>
      <a class="text-link micro" href="/lab/">
        OPEN LAB →
      </a>
    </aside>
  </div>
</BaseLayout>
