---
import Arrow from '../../components/Arrow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDossier from '../../components/ProjectDossier.astro';
import ProjectPosters from '../../components/ProjectPosters.astro';
import NodeCard from '../../components/NodeCard.astro';
import { projects } from '../../data/site';
import SectionHeading from '../../components/SectionHeading.astro';
import { portfolioGroups } from '../../data/portfolio';
---

<BaseLayout
  title="Projects — KEJINCAI.DEV"
  description="Three systems for everyday use: Infinity New Tab, Disk Ferry and Safe Clip. 東京発のソフトウェアと独立ノード。"
>
  <div class="container page-content page-content-lead">
    <div class="page-heading">
      <p class="eyebrow yellow">SELECTED WORK / 03</p>
      <h1>Systems online.</h1>
      <p lang="ja">THREE SYSTEMS. 日常で使うために、組み上げた。</p>
    </div>
  </div>
  <ProjectPosters
    label="/// .SELECTED.MODULE_実装記録"
    title="Select a system."
    description="LEARN MORE で各システムの設計、数値、ソースへ。"
  />
  <div class="container page-content page-content-follow">
    <section
      class="portfolio-section"
      id="selected"
      aria-label="SELECTED / 実装記録"
    >
      <div class="dossier-list">
        {portfolioGroups[0].projects.map((project, index) => (
          <ProjectDossier
            project={project}
            number={String(index + 1).padStart(2, '0')}
            flip={index % 2 === 1}
          />
        ))}
      </div>
    </section>
    <section class="portfolio-section" id="connected">
      <SectionHeading
        label="CONNECTED NODES"
        title="Connected worlds."
        description="Independent nodes. 記録は続く。"
      />
      <div class="node-grid">
        {projects.map((project) => (
          <NodeCard project={project} />
        ))}
      </div>
    </section>
    <aside class="lab-invitation">
      <div>
        <p class="micro">SIDE PROJECTS / SMALL TOOLS</p>
        <p lang="ja">SIDE CHANNEL OPEN. 小さな実験とスクリプトは Lab へ。</p>
      </div>
      <a class="text-link micro" href="/lab/">
        OPEN LAB <Arrow />
      </a>
    </aside>
  </div>
</BaseLayout>
