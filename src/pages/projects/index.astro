---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NodeCard from '../../components/NodeCard.astro';
import { projects } from '../../data/site';
---

<BaseLayout
  title="Projects — KEJINCAI.DEV"
  description="Independent projects in language, AI and software engineering. Three connected worlds from a personal node in Tokyo."
>
  <div class="container page-content">
    <div class="page-heading">
      <p class="eyebrow cyan">01 / ACTIVE NODES</p>
      <h1>Connected worlds.</h1>
      <p>Independent projects. One personal node.</p>
    </div>
    <div class="node-grid">
      {projects.map((project) => (
        <NodeCard project={project} />
      ))}
    </div>
    <p class="page-note mono">
      Each node has its own focus. Follow a connection to explore.
    </p>
    <div class="cross-link">
      <span>Smaller tools and ideas live in the lab.</span>
      <a class="text-link micro" href="/lab/">
        EXPLORE LAB →
      </a>
    </div>
  </div>
</BaseLayout>
