---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Arrow from '../components/Arrow.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import NodeCard from '../components/NodeCard.astro';
import { projects } from '../data/site';
import { portfolioGroups, portfolioCount } from '../data/portfolio';
---

<BaseLayout>
  <Hero />
  <section class="system-band" id="system" aria-label="System status">
    <dl class="container system-grid">
      <div>
        <dt>SYSTEM / LOCATION</dt>
        <dd>
          TOKYO <span class="micro">JP</span>
        </dd>
      </div>
      <div>
        <dt>ROOT NODE</dt>
        <dd>KEJINCAI.DEV</dd>
      </div>
      <div>
        <dt>STATUS</dt>
        <dd class="online">
          <i></i> ONLINE
        </dd>
      </div>
      <div>
        <dt>SELECTED WORK</dt>
        <dd>{String(portfolioGroups[0].projects.length).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>EXPERIMENTS / TOOLS</dt>
        <dd>
          {String(portfolioCount - portfolioGroups[0].projects.length).padStart(
            2,
            '0',
          )}
        </dd>
      </div>
      <div>
        <dt>LAST UPDATE</dt>
        <dd>2026.09.28</dd>
      </div>
    </dl>
  </section>
  <section class="section container" id="selected-work">
    <SectionHeading
      label="01 / 精选项目"
      title="Selected work."
      description="把想法做成日常用得上的软件。"
    >
      <a class="text-link micro" href="/projects/">
        VIEW PROJECTS <Arrow />
      </a>
    </SectionHeading>
    <div class="work-grid work-grid-featured">
      {portfolioGroups[0].projects.map((project, index) => (
        <PortfolioCard
          project={project}
          number={String(index + 1).padStart(2, '0')}
          featured
        />
      ))}
    </div>
  </section>
  <section class="section container" id="nodes">
    <SectionHeading
      label="02 / CONNECTED NODES"
      title="Connected worlds."
      description="独立网站，持续记录。"
    />
    <div class="node-grid">
      {projects.map((project) => (
        <NodeCard project={project} />
      ))}
    </div>
  </section>
  <aside class="lab-invitation container">
    <div>
      <p class="micro">SIDE PROJECTS / SMALL TOOLS</p>
      <p lang="zh-CN">还有一些好玩的小实验，以及解决日常问题的小工具。</p>
    </div>
    <a class="text-link micro" href="/lab/">
      OPEN LAB <Arrow />
    </a>
  </aside>
  <section class="about-strip container">
    <p class="eyebrow yellow">ABOUT NODE</p>
    <div>
      <h2 lang="ja">作る。学ぶ。記録する。</h2>
      <p>
        Software Engineer based in Tokyo.
        <br />
        Building things. Learning along the way.
      </p>
    </div>
    <a class="text-link micro" href="/about/">
      MEET THE NODE <Arrow />
    </a>
  </section>
</BaseLayout>
