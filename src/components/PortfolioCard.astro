---
import Arrow from './Arrow.astro';
import ProjectIcon from './ProjectIcon.astro';
import type { PortfolioProject } from '../data/portfolio';
interface Props {
  project: PortfolioProject;
  number: string;
  featured?: boolean;
}
const { project, number, featured = false } = Astro.props;
---

<a
  class:list={['work-card', { 'work-card-featured': featured }]}
  href={`https://github.com/kekincai/${project.repo}`}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="work-card-header">
    <span class="micro">PROJECT / {number}</span>
    <Arrow diagonal />
  </div>
  <div class="work-card-main">
    <ProjectIcon repo={project.repo} />
    <div>
      <h3 lang={project.repo === 'yinxiang-exporter' ? 'zh-CN' : 'en'}>
        {project.name}
      </h3>
      <p class="work-description" lang="zh-CN">
        {project.description}
      </p>
    </div>
  </div>
  <div class="work-card-footer">
    <ul aria-label="Technology and platform">
      {project.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <span class="work-source micro">
      GITHUB <Arrow diagonal />
    </span>
  </div>
</a>
