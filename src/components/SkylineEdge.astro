---
interface Props {
  position: 'top' | 'bottom';
}
const { position } = Astro.props;

// Deterministic silhouette so every build renders the same edge.
let seed = 2077;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const blocks: { x: number; w: number; h: number }[] = [];
for (let x = 0; x < 1440;) {
  const w = 8 + Math.round(random() * 46);
  const h = random() < 0.35 ? 0 : 3 + Math.round(random() * 13);
  blocks.push({ x, w, h });
  if (random() < 0.18) blocks.push({ x: x + w / 2, w: 2, h: h + 7 });
  x += w;
}
---

<svg
  class:list={['skyline-edge', `skyline-edge-${position}`]}
  viewBox="0 0 1440 24"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <rect width="1440" height="3" />
  {blocks.map((block) => (
    <rect x={block.x} width={block.w} height={block.h} />
  ))}
</svg>
