---
import Arrow from './Arrow.astro';
import SkylineEdge from './SkylineEdge.astro';
import { site } from '../data/site';
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<section class="uplink" aria-labelledby="uplink-title">
  <SkylineEdge position="top" />
  <div class="container uplink-inner">
    <p class="micro">{label}</p>
    <h2 id="uplink-title" lang="ja">
      <span>構築。</span>
      <span>解析。</span>
      <span>記録。</span>
    </h2>
    <p class="uplink-lead">
      SOFTWARE ENGINEER / TOKYO NODE. BUILD. LEARN. LOG. / 次の信号へ。
    </p>
    <div class="poster-brackets" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="uplink-form">
      <a class="uplink-field" href={`mailto:${site.email}`}>
        <span class="micro">UPLINK ADDRESS</span>
        <span>{site.email}</span>
      </a>
      <a class="uplink-send" href={`mailto:${site.email}`}>
        SEND SIGNAL <Arrow />
      </a>
    </div>
    <a class="text-link text-link-dark micro" href="/about/">
      MEET THE NODE <Arrow />
    </a>
  </div>
  <SkylineEdge position="bottom" />
</section>
