---
import NodeNetwork from './NodeNetwork.astro';
import Arrow from './Arrow.astro';
import Directives from './Directives.astro';
import SkylineEdge from './SkylineEdge.astro';
import { site } from '../data/site';
---

<section class="hero" data-header-ink="dark">
  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow">00 // TOKYO PERSONAL NODE</p>
      <h1 class="visually-hidden">KE JINCAI</h1>
      <p class="hero-directives">
        <Directives />
      </p>
      <a class="uplink" href={`mailto:${site.email}`}>
        <span class="uplink-address">
          <span class="micro">UPLINK ADDRESS</span>
          <span>{site.email}</span>
        </span>
        <span class="uplink-send">
          SEND SIGNAL <Arrow />
        </span>
      </a>
    </div>
    <NodeNetwork />
  </div>
  <SkylineEdge position="bottom" />
</section>
