---
import NodeNetwork from './NodeNetwork.astro';
import Arrow from './Arrow.astro';
---

<section class="hero">
  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow">// TOKYO / PERSONAL NODE</p>
      <h1>
        <span>KE</span>{' '}
        <span>
          JINCAI<span class="name-dot">_</span>
        </span>
      </h1>
      <div class="hero-meta">
        <p class="hero-japanese" lang="ja">
          作る。
          <br />
          学ぶ。
          <br />
          記録する。
        </p>
        <div class="hero-description">
          <p>Software Engineer</p>
          <p class="mono">AI / Web / Data / Photography</p>
        </div>
      </div>
      <a class="button button-primary" href="/projects/">
        VIEW PROJECTS <Arrow />
      </a>
    </div>
    <NodeNetwork />
    <a class="scroll-cue micro" href="#system">
      SCROLL <span>↓</span>
    </a>
  </div>
</section>
