---
import NodeNetwork from './NodeNetwork.astro';
import Arrow from './Arrow.astro';
import Directives from './Directives.astro';
import SkylineEdge from './SkylineEdge.astro';
import { site } from '../data/site';
---

<section class="hero" data-header-ink="dark">
  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow">// TOKYO / PERSONAL NODE</p>
      <h1>
        <span>KE</span>{' '}
        <span>
          JINCAI<span class="name-dot">_</span>
        </span>
      </h1>
      <div class="hero-meta">
        <p class="hero-japanese">
          <Directives />
        </p>
        <div class="hero-description">
          <p>Software Engineer</p>
          <p class="mono">AI / Web / Data / Photography</p>
        </div>
      </div>
      <div class="uplink-form">
        <a class="uplink-field" href={`mailto:${site.email}`}>
          <span class="micro">UPLINK ADDRESS</span>
          <span>{site.email}</span>
        </a>
        <a class="uplink-send" href={`mailto:${site.email}`}>
          SEND SIGNAL <Arrow />
        </a>
      </div>
    </div>
    <NodeNetwork />
  </div>
  <SkylineEdge position="bottom" />
</section>
