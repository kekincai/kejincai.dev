---
import { site } from '../data/site';
const channels = [
  { label: 'GitHub', glyph: 'GH', href: site.github, external: true },
  { label: 'Email', glyph: '@', href: `mailto:${site.email}` },
  { label: 'RSS', glyph: 'RSS', href: '/rss.xml' },
  { label: 'Source', glyph: '</>', href: site.repository, external: true },
];
const links = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Lab', href: '/lab/' },
  { label: 'About', href: '/about/' },
  { label: site.email, href: `mailto:${site.email}` },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-find">
      <span class="micro">FIND THE NODE ON</span>
      <ul>
        {channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              aria-label={channel.label}
              title={channel.label}
              {...(channel.external
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {channel.glyph}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <div class="footer-legal">
      <a class="wordmark" href="/">
        KEJINCAI<span>.DEV</span>
      </a>
      <p class="mono">
        © {new Date().getFullYear()} KE JINCAI. TOKYO NODE / BUILD: ASTRO +
        CLOUDFLARE. <span lang="ja">構築。解析。記録。</span>
      </p>
      <span class="footer-status">
        <span class="online">
          <i></i> ONLINE
        </span>
        <span class="eof mono">
          EOF<span class="cursor">_</span>
        </span>
      </span>
    </div>
  </div>
</footer>
