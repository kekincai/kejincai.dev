---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
const links = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Lab', href: '/lab/' },
  { label: 'About', href: '/about/' },
  { label: 'GitHub', href: site.github, external: true },
  { label: 'RSS', href: '/rss.xml' },
  { label: site.email, href: `mailto:${site.email}` },
];
---

<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label="Footer">
      {links.map((link) => (
        <a
          href={link.href}
          {...(link.external
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="footer-legal">
      <a class="footer-logo" href="/" aria-label="KEJINCAI.DEV home">
        <Wordmark />
      </a>
      <p class="mono">
        © {new Date().getFullYear()} KE JINCAI. TOKYO NODE / BUILD: ASTRO +
        CLOUDFLARE. <span lang="ja">接続せよ。構築せよ。記録せよ。</span>
      </p>
      <span class="footer-status">
        <span class="online">
          <i></i> ONLINE
        </span>
        <span class="eof mono">
          EOF<span class="cursor">_</span>
        </span>
      </span>
    </div>
  </div>
</footer>
