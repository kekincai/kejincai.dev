---
// Original brush-slash lettering in the spirit of the Cyberpunk 2077
// wordmark; every glyph is authored here, no font or logo is copied.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

type Stroke = [number, number, number, number, number, number];
// A tapered stroke: from (x1, y1) at width w1 to (x2, y2) at width w2.
const quad = ([x1, y1, x2, y2, a, b]: Stroke) => {
  const w1 = a * 1.3;
  const w2 = b * 1.3;
  const len = Math.hypot(x2 - x1, y2 - y1) || 1;
  const nx = -(y2 - y1) / len;
  const ny = (x2 - x1) / len;
  const p = [
    [x1 + (nx * w1) / 2, y1 + (ny * w1) / 2],
    [x2 + (nx * w2) / 2, y2 + (ny * w2) / 2],
    [x2 - (nx * w2) / 2, y2 - (ny * w2) / 2],
    [x1 - (nx * w1) / 2, y1 - (ny * w1) / 2],
  ];
  return `M${p.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L')}Z`;
};

// Glyphs on a 40-unit cap height (y 10 → 50); advance is the glyph width.
const glyphs: Record<string, { advance: number; strokes: Stroke[] }> = {
  K: {
    advance: 30,
    strokes: [
      [4, 2, 3, 56, 11, 7],
      [6, 34, 34, 2, 9, 1],
      [9, 29, 30, 52, 9, 3],
      [30, 52, 44, 64, 3, 0.5],
    ],
  },
  E: {
    advance: 24,
    strokes: [
      [3, 11, 3, 50, 8, 8],
      [0, 11, 24, 9, 8, 2],
      [3, 30, 19, 29, 7, 2],
      [0, 50, 25, 50, 8, 1.5],
    ],
  },
  J: {
    advance: 23,
    strokes: [
      [3, 11, 25, 9, 8, 2],
      [17, 11, 15, 46, 8, 8],
      [15, 46, 3, 51, 8, 3],
      [8, 50, -6, 66, 4, 0.5],
    ],
  },
  I: { advance: 11, strokes: [[5, 10, 4, 50, 8, 8]] },
  N: {
    advance: 27,
    strokes: [
      [3, 52, 3, 12, 8, 7],
      [3, 10, 22, 50, 8, 8],
      [22, 50, 23, 4, 7, 1],
    ],
  },
  C: {
    advance: 24,
    strokes: [
      [26, 9, 5, 11, 2, 8],
      [4, 10, 3, 50, 8, 8],
      [2, 50, 27, 49, 8, 1.5],
    ],
  },
  A: {
    advance: 28,
    strokes: [
      [2, 52, 13, 10, 7, 8],
      [13, 10, 25, 50, 8, 8],
      [7, 36, 22, 35, 6, 2],
    ],
  },
  '.': { advance: 12, strokes: [[3, 47, 8, 47, 6, 6]] },
  D: {
    advance: 27,
    strokes: [
      [3, 10, 3, 50, 8, 8],
      [0, 11, 17, 10, 8, 6],
      [17, 10, 25, 19, 6, 7],
      [25, 18, 25, 42, 8, 8],
      [25, 41, 17, 50, 7, 6],
      [17, 50, 0, 50, 7, 8],
    ],
  },
  V: {
    advance: 26,
    strokes: [
      [1, 10, 12, 50, 8, 8],
      [12, 50, 26, 10, 8, 5],
      [26, 10, 40, -6, 5, 0.5],
    ],
  },
};

const text = 'KEJINCAI.DEV';
let x = 4;
const paths: string[] = [];
for (const char of text) {
  const glyph = glyphs[char];
  paths.push(
    glyph.strokes
      .map(([x1, y1, x2, y2, w1, w2]) => quad([x1 + x, y1, x2 + x, y2, w1, w2]))
      .join(''),
  );
  x += glyph.advance + 4;
}
const width = Math.ceil(x + 30);
const letters = paths.join('');
---

<svg
  class:list={['wordmark-svg', className]}
  viewBox={`-6 -8 ${width} 76`}
  role="img"
  aria-label="KEJINCAI.DEV"
>
  <g transform="skewX(-18) translate(14 0)">
    <path class="wordmark-shadow" d={letters} transform="translate(2.4 1.6)" />
    <path class="wordmark-ink" d={letters} />
    <path
      class="wordmark-shadow"
      d={`M44 56h${width - 150}v1.4H44Z M${width - 118} 58h40v1H${width - 118}Z`}
    />
  </g>
</svg>
