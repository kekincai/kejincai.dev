---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
const links = [
  { href: '/projects/', label: 'PROJECTS' },
  { href: '/lab/', label: 'LAB' },
  { href: '/about/', label: 'ABOUT' },
];
const path = Astro.url.pathname;
---

<header class:list={['site-header', { 'over-hero': path === '/' }]}>
  <div class="header-inner container">
    <a class="header-logo" href="/" aria-label="KEJINCAI.DEV home">
      <Wordmark />
    </a>
    <nav id="main-nav" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <span class="online">
        <i></i> ONLINE
      </span>
      <a class="nav-cta" href={`mailto:${site.email}`}>
        CONTACT
      </a>
    </nav>
  </div>
</header>
<script>
  // Over yellow bands the logo turns black like the official site.
  function syncHeader() {
    const header = document.querySelector('.site-header');
    const onLight = [
      ...document.querySelectorAll('[data-header-ink="dark"]'),
    ].some((band) => {
      const rect = band.getBoundingClientRect();
      return rect.top < 40 && rect.bottom > 40;
    });
    header?.classList.toggle('over-hero', onLight);
    header?.classList.toggle('is-scrolled', scrollY > 8);
  }
  addEventListener('scroll', syncHeader, { passive: true });
  document.addEventListener('astro:page-load', syncHeader);
  syncHeader();
</script>
