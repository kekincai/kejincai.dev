{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kejincai-dev",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kejincai.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
